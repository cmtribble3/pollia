+        return dr::if_stmt(dr::make_tuple(a, b, j0, j1), first,
+            [](const Stokes &, const Stokes &, const Stokes &row0, const Stokes &row1) {
+                return dr::make_tuple(row0, row1, Stokes(1.f, 0.f, 0.f, 0.f));
+            }, general, "PIS identity composition");
