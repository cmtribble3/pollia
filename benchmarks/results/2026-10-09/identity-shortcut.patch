+    static auto continued(const Stokes &a, const Stokes &b, const Jones &j,
+                          Bool first, bool shortcut) {
+        auto general = [](const Stokes &pa, const Stokes &pb,
+                          const Stokes &j0, const Stokes &j1) {
+            Jones acc = pollia::unpack_jones(pa, pb);
+            Jones next = pollia::multiply(acc, pollia::unpack_jones(j0, j1));
+            return dr::make_tuple(pollia::pack_jones_row0(next),
+                                  pollia::pack_jones_row1(next),
+                                  pollia::jones_first_column(acc));
